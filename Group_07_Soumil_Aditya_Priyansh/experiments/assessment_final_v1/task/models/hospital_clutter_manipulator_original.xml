<mujoco model="hospital_clutter_mobile_manipulator">
  <include file="stretch_mj_3.3.0.xml"/>
  <compiler angle="radian" meshdir="assets/" texturedir="assets/"/>

  <!-- DO NOT override <option> — the Stretch model's implicitfast integrator is used.
       The previous RK4 integrator caused NaN instability with the Stretch's freejoint base. -->

  <visual>
    <headlight ambient="0.5 0.5 0.5" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <rgba fog="0.92 0.94 0.96 1"/>
    <quality shadowsize="1024"/>
    <map znear="0.01"/>
    <global offwidth="640" offheight="480"/>
  </visual>

  <worldbody>
