  <!-- ============ KEYFRAME: Robot positioned for starting, room is MESSY ============ -->
  <keyframe>
    <!-- qpos layout (111 total = 27 robot + 7 per each of 12 clutter objects):
         [0-6]    base_link freejoint: x y z qw qx qy qz
         [7]      joint_right_wheel
         [8]      joint_left_wheel
         [9]      joint_lift (0.0-1.1m)
         [10-13]  joint_arm_l3..l0  (telescope, 4x 0-0.13)
         [14]     joint_wrist_yaw
         [15]     joint_wrist_pitch
         [16]     joint_wrist_roll
         [17]     joint_gripper_slide
         [18-19]  joint_gripper_finger_left_open, rubber_left_x
         [20]     rubber_left_y
         [21-22]  joint_gripper_finger_right_open, rubber_right_x
         [23]     rubber_right_y
         [24]     joint_head_pan
         [25]     joint_head_tilt
         [26]     joint_head_nav_cam
         [27-33]  cup_free:      x y z qw qx qy qz
         [34-40]  bottle_free:   x y z qw qx qy qz
